<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760" prefWidth="1140" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.KatalogController">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header">
                <ImageView fx:id="remEmblemView" fitHeight="56" fitWidth="56" pickOnBounds="true" preserveRatio="true" />
                <VBox spacing="2">
                    <Label prefHeight="39.0" prefWidth="170.0" styleClass="title" text="Katalog Produk" />
                    <Label styleClass="subtitle" text="Alpin Store" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" prefWidth="250" promptText="Cari nama produk atau ID..." styleClass="search-field" />
                <Label fx:id="jumlahLabel" styleClass="count-pill" text="Total: 0 Produk" />
            </HBox>
            <Region prefHeight="4" styleClass="rem-ribbon-line" />
        </VBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="344" styleClass="sidebar-scroll">
            <content>
                <VBox spacing="12" styleClass="sidebar-card">
                    <Label fx:id="modeBadgeLabel" styleClass="mode-badge-add" text="Tambah Produk" />

                    <VBox spacing="6">
                        <StackPane minHeight="152" prefHeight="152" styleClass="preview-frame">
                            <ImageView fx:id="previewImageView" fitHeight="138" fitWidth="240" pickOnBounds="true" preserveRatio="true" />
                            <Label fx:id="previewFallbackLabel" styleClass="no-image-text" text="Tanpa Gambar" visible="false" />
                        </StackPane>
                        <Label fx:id="selectedFotoLabel" styleClass="foto-caption" text="Foto bawaan: roti.png" wrapText="true" />
                    </VBox>

                    <VBox spacing="5">
                        <Label styleClass="field-label" text="Nama Produk" />
                        <TextField fx:id="namaField" promptText="Contoh: Roti Krim Biru" />
                    </VBox>

                    <VBox spacing="5">
                        <Label styleClass="field-label" text="Harga (Rp)" />
                        <TextField fx:id="hargaField" promptText="Contoh: 15000" />
                    </VBox>

                    <VBox spacing="7">
                        <Label styleClass="field-label" text="Foto Produk" />
                        <ComboBox fx:id="fotoBox" maxWidth="Infinity" promptText="Pilih foto bawaan..." />
                        <HBox spacing="8">
                            <Button maxWidth="Infinity" onAction="#chooseManualImage" styleClass="button-upload" text="Pilih Gambar..." HBox.hgrow="ALWAYS" />
                            <Button fx:id="removeImageButton" onAction="#removeSelectedImage" styleClass="button-remove-img" text="Hapus Gambar" />
                        </HBox>
                    </VBox>

                    <HBox spacing="8">
                        <Button fx:id="saveButton" maxWidth="Infinity" onAction="#saveProduct" styleClass="button-primary" text="Simpan Produk" HBox.hgrow="ALWAYS" />
                        <Button fx:id="cancelEditButton" onAction="#cancelEdit" styleClass="button-cancel" text="Batal" />
                    </HBox>

                    <Label fx:id="pesanLabel" maxWidth="Infinity" styleClass="status-box" wrapText="true" />
                </VBox>
            </content>
            <padding>
                <Insets bottom="18" left="18" right="8" top="18" />
            </padding>
        </ScrollPane>
    </left>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="katalog-scroll">
            <content>
                <TilePane fx:id="katalogPane" alignment="TOP_LEFT" hgap="18" styleClass="katalog" tileAlignment="TOP_LEFT" vgap="18" />
            </content>
        </ScrollPane>
    </center>
</BorderPane>
